VITE_APP_MODE=desktop
# EMPTY, exactly like .env.server - the SPA calls its own origin.
#
# This was http://localhost:4246, which is the port the desktop app happens to listen on by
# default. It is baked into the bundle at build time, so the packaged UI called 4246 no matter
# which port it was actually being served from: run the app on any other port and every request
# in the page fails with ERR_CONNECTION_REFUSED while the page itself loads fine. That reads as a
# dead backend and is a hardcoded address.
#
# Same-origin is also simply true. Both editions serve their own UI - frontend-maven-plugin builds
# the SPA into the jar and SpaWebConfig serves it - so the page and the API are one origin by
# construction, and naming that origin absolutely can only ever be a way to get it wrong.
#
# The dev server needs a real address to proxy TO, but that is a different question with a
# different answer: PROXYMA_DEV_API_TARGET, which has no VITE_ prefix and so is never exposed to
# client code. See vite.config.ts.
VITE_API_BASE_URL=
