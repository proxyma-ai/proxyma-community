<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.proxyma</groupId>
        <artifactId>proxyma-parent</artifactId>
        <version>0.36.0</version>
    </parent>

    <artifactId>proxyma-core-ingest</artifactId>
    <name>proxyma-core-ingest</name>
    <description>Document content processing: fetch, parse (Markitdown), chunk (cl100k_base), embed. Source-agnostic, no JPA entities.</description>

    <dependencies>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-common</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-connector</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-indexstore</artifactId>
        </dependency>
        <!-- OcrService's vision engine calls a multimodal chat model through LlmProviderFactory,
             and reads its own engine/provider/model choice from SettingsService (transitively
             available via indexstore, declared here since it is imported directly). Same direction
             as search/chat/system depend on provider - provider itself only depends on
             common/network/settings, so this adds no cycle. -->
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-settings</artifactId>
        </dependency>
        <!-- HTML->Markdown for uploaded/crawled .html/.htm content (DefaultDocumentFetcher) - the
             same jsoup + flexmark + readability4j pipeline WebCrawlConnector and WebFetchTool use,
             transitively available via proxyma-core-connector but declared explicitly since it's
             imported directly here too. -->
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-webcontent</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>

        <!-- JTokkit tokenizer (cl100k_base chunking) -->
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
        </dependency>
    </dependencies>

</project>
