<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.proxyma</groupId>
        <artifactId>proxyma-parent</artifactId>
        <version>0.37.1</version>
    </parent>

    <artifactId>proxyma-connectors</artifactId>
    <name>proxyma-connectors</name>
    <description>Source connectors built on the connector framework v2 - one package per service
        (ai.proxyma.connectors.NAME), each a ConnectorPlugin, its session, a ConnectionPlugin and
        tests against a loopback fake. They depend on proxyma-core-connector's SPI and nothing else of
        the application, so a connector cannot reach into the registry, the settings or another
        connector; the application finds them by component scan.</description>

    <dependencies>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-connector</artifactId>
        </dependency>

        <!-- IMAP (ai.proxyma.connectors.imap): Eclipse Angus Mail, the Jakarta Mail implementation -
             the same artifact spring-boot-starter-mail brings to proxyma-core-auth, pinned to the
             version the Spring Boot BOM manages for it (angus-mail.version, 2.0.5 with Boot 3.5.16) so
             the server jar holds one copy. EPL-2.0 / GPL-2.0 with Classpath Exception / BSD-3-Clause. -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>${angus-mail.version}</version>
        </dependency>

        <!-- The framework's fake HTTP API (LoopbackApi), which every connector here is tested against. -->
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-connector</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- An in-process IMAP server for the IMAP connector's tests (GreenMail, Apache-2.0). 2.1.14
             is built against the same Angus Mail 2.0.5 as above, whose jar already holds the Jakarta
             Mail API, so the separate API jar is left out; its JUnit 4 rule is not used, so JUnit 4
             stays off the classpath too. -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>2.1.14</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.mail</groupId>
                    <artifactId>jakarta.mail-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

</project>
