<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.proxyma</groupId>
        <artifactId>proxyma-parent</artifactId>
        <version>0.36.2</version>
    </parent>

    <artifactId>proxyma-core-search</artifactId>
    <name>proxyma-core-search</name>
    <description>Hybrid search pipeline: query expansion, BM25 + dense retrieval, RRF fusion, reranking, MMR diversity</description>

    <dependencies>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-indexstore</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-registry</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-settings</artifactId>
        </dependency>
        <!-- SEARCH telemetry, recorded at the end of SearchService.search(). Safe in this
             direction: proxyma-core-telemetryclient depends on settings, license and
             shared-contracts only, so it cannot reach back to search. proxyma-core-chat is the
             module that CANNOT be depended on from telemetryclient - it already depends on it. -->
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-telemetryclient</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>

        <!-- Bridges SearchContext's userId ThreadLocal across Reactor scheduler hops (e.g.
             spring-ai-mcp's Schedulers.boundedElastic() tool execution) via automatic context
             propagation. Version managed by the spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>
    </dependencies>

</project>
