<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.proxyma</groupId>
        <artifactId>proxyma-parent</artifactId>
        <version>0.38.0</version>
    </parent>

    <artifactId>proxyma-core-chat</artifactId>
    <name>proxyma-core-chat</name>
    <description>ReAct chat agent, conversation history, token-window memory</description>

    <dependencies>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-search</artifactId>
        </dependency>
        <!-- The guardrails a turn passes through on the way in and on the way out. One-way, as
             that module's own pom says: it is handed a string and answers about it, and nothing
             in there knows a conversation exists. -->
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-guardrail</artifactId>
        </dependency>
        <!-- Feedback is shipped to proxyma-telemetry rather than only stored locally - see
             FeedbackController. Acyclic: telemetryclient depends on settings/license/contracts
             and never on chat. -->
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-telemetryclient</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-settings</artifactId>
        </dependency>
        <!-- Knowledge graph. Reached transitively through registry either way; declared here
             because this module names its types directly, and a transitive dependency that a
             refactor elsewhere could drop is not one to compile against. -->
        <dependency>
            <groupId>ai.proxyma</groupId>
            <artifactId>proxyma-core-graph</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <!-- Without spring-aspects, and so without aspectjweaver (EPL-2.0 only, which the AGPL
                 cannot carry): nothing in Proxyma is an @Aspect - see proxyma-parent's pom. -->
            <exclusions>
                <exclusion>
                    <groupId>org.springframework</groupId>
                    <artifactId>spring-aspects</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- H2 embedded database (desktop mode) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

</project>
