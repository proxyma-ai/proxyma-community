    <!-- Inherited by all 27 modules, so a test can be written next to the code it covers without
         first editing that module's pom. Test scope, so nothing here reaches a shipped jar.

         Added 2026-09-03, with the first tests. Until then this project had no test suite at all
         and CLAUDE.md said so; `tsc -b` and `mvn package` were the only automated checks. Note
         that every documented build command passes -DskipTests, which is right for a release
         build and wrong for a check - CI runs `mvn test` separately for that reason. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Default: skip spring-boot:run on all modules.
                     Modules with a mainClass override this in their own <build><plugins>. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.7.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>1.15.0</version>
                </plugin>
                <!-- THE JAVA HALF OF THIRD-PARTY-NOTICES.txt (apps/app/third-party/notices.xml).
                     Lists every library the application jar carries - name, coordinates, project
                     URL and license - into target/third-party/java.txt, which notices.xml then
                     joins with the web and Python lists and the hand-written header.

                     Configured HERE and declared, with no configuration of its own, by the two
                     modules that build an application jar: proxyma-desktop and proxyma-server.
                     The template is read from ${proxyma.third-party.dir}, which proxyma-server
                     (in ee/backend since 2026-10-15) points back at apps/app/third-party.

                     prepare-package, not the plugin's default generate-resources: `mvn test`
                     (test:backend, which lists :proxyma-desktop) never reaches it, so the thirty-
                     second test job does not pay for a license scan.

                     Offline once the plugin itself is resolved: every license comes from the
                     dependency POMs Maven already downloaded to build the jar.
                     useRepositoryMissingFiles=false is what keeps it so - left on, the plugin asks
                     every repository for a G:A:V:properties:third-party artifact per dependency
                     with no license, which is a network round trip each and never exists.

                     THE ALLOW-LIST FAILS THE BUILD. Every license name a POM states is merged to
                     one canonical name (licenseMerges), and a dependency whose canonical license is
                     not in includedLicenses stops the build (failOnBlacklist), as does one with no
                     license at all (failOnMissing). So an AGPL library, or a GPL one without the
                     Classpath Exception, cannot reach a jar unnoticed - and neither can a new
                     spelling of a license already here, which is the price: add the spelling to
                     the merge list. A dependency whose POM states no license at all needs an
                     overrideUrl file naming it, read from the project's own LICENSE - there is
                     none today, so there is no such file. -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>2.7.1</version>
                    <executions>
                        <execution>
                            <id>third-party-java</id>
                            <phase>prepare-package</phase>
                            <goals><goal>add-third-party</goal></goals>
                            <configuration>
                                <outputDirectory>${project.build.directory}/third-party</outputDirectory>
                                <thirdPartyFilename>java.txt</thirdPartyFilename>
                                <addOutputDirectoryAsResourceDir>false</addOutputDirectoryAsResourceDir>
                                <useRepositoryMissingFiles>false</useRepositoryMissingFiles>
                                <deployMissingFile>false</deployMissingFile>
                                <force>true</force>
                                <!-- What spring-boot:repackage puts in BOOT-INF/lib: compile,
                                     runtime and provided. Not our own modules - they inherit
                                     spring-boot-starter-parent's <licenses>, so without this the
                                     list would call Proxyma itself Apache-2.0. Nor the
                                     spring-boot-starter-* jars, which repackage leaves out - they
                                     hold no code. Write each pattern to match the WHOLE id: with
                                     2.7.1, `^(proxyma-|spring-boot-starter)` excluded nothing,
                                     `spring-boot-starter.*` works. The list was checked
                                     against BOOT-INF/lib on 2026-10-09: it differs only by the
                                     platform-classifier copies of netty natives and Spring Boot's
                                     own jarmode-tools. -->
                                <excludedScopes>test,system</excludedScopes>
                                <excludedGroups>ai\.proxyma</excludedGroups>
                                <excludedArtifacts>proxyma-.*|spring-boot-starter.*</excludedArtifacts>
                                <sortArtifactByName>true</sortArtifactByName>
                                <fileTemplate>${proxyma.third-party.dir}/java-list.ftl</fileTemplate>
                                <!-- First name is the one printed; every POM spelling seen on
                                     2026-10-09 is listed after it. SPDX identifiers where one fits. -->
                                <licenseMerges>
                                    <licenseMerge>Apache-2.0|Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache 2.0|The Apache License, Version 2.0|Apache 2|Apache License 2.0|Apache License Version 2.0|Apache Software License - Version 2.0|Apache License, version 2.0</licenseMerge>
                                    <licenseMerge>MIT|MIT License|The MIT License (MIT)|The MIT License|MIT license|MIT-License</licenseMerge>
                                    <licenseMerge>BSD-2-Clause|BSD 2-Clause License|The BSD 2-Clause License</licenseMerge>
                                    <licenseMerge>BSD-3-Clause|BSD New license|BSD licence|The BSD License|BSD License 3|The 3-Clause BSD License|New BSD License|Revised BSD</licenseMerge>
                                    <licenseMerge>EDL-1.0 (BSD-3-Clause)|Eclipse Distribution License - v 1.0|EDL 1.0|Eclipse Distribution License v. 1.0</licenseMerge>
                                    <licenseMerge>EPL-1.0|Eclipse Public License - v 1.0|EPL 1.0|Eclipse Public License 1.0</licenseMerge>
                                    <licenseMerge>EPL-2.0|EPL 2.0|Eclipse Public License v. 2.0|Eclipse Public License - v 2.0|Eclipse Public License 2.0|Eclipse Public License v2.0</licenseMerge>
                                    <licenseMerge>GPL-2.0-only WITH Classpath-exception-2.0|GPL2 w/ CPE|GNU General Public License, version 2 with the GNU Classpath Exception</licenseMerge>
                                    <licenseMerge>CDDL-1.1 OR GPL-2.0-only WITH Classpath-exception-2.0|CDDL + GPLv2 with classpath exception</licenseMerge>
                                    <licenseMerge>LGPL-2.1-or-later|GNU Library General Public License v2.1 or later|GNU Lesser General Public License|GNU Lesser General Public License, Version 2.1</licenseMerge>
                                    <licenseMerge>MPL-2.0|MPL 2.0|Mozilla Public License, Version 2.0|Mozilla Public License 2.0</licenseMerge>
                                    <licenseMerge>CC0-1.0|Public Domain, per Creative Commons CC0|CC0</licenseMerge>
                                    <licenseMerge>Bouncy Castle Licence (MIT)|Bouncy Castle Licence</licenseMerge>
                                </licenseMerges>
                                <!-- The allow-list: exactly the canonical names above, plus MIT-0.
                                     Every other name fails the build. Adding a license here is a
                                     decision about what the product may ship - an AGPL or a plain
                                     GPL library must not be added to make a build pass.

                                     EPL-2.0 is here for libraries that also offer a GPL-compatible
                                     choice (Jakarta's GPL-2.0 with the Classpath Exception). The one
                                     library under EPL-2.0 ALONE was org.aspectj:aspectjweaver, which
                                     spring-boot-starter-data-jpa brings in through spring-aspects -
                                     and EPL-2.0 alone is not compatible with the AGPL. Excluded since
                                     2026-10-15 wherever a module declares that starter: spring-aspects
                                     serves only AspectJ weaving, @Configurable and Spring Data's JPA
                                     auditing, and Proxyma uses none of them - no @Aspect anywhere;
                                     @Transactional and @Async are Spring's own proxies, which Spring
                                     Boot's AopAutoConfiguration sets up without AspectJ. A module that
                                     declares the starter again must exclude it too:
                                     `mvn dependency:tree -Dincludes=org.aspectj` shows nothing. -->
                                <includedLicenses>
                                    <includedLicense>Apache-2.0</includedLicense>
                                    <includedLicense>MIT</includedLicense>
                                    <includedLicense>MIT-0</includedLicense>
                                    <includedLicense>BSD-2-Clause</includedLicense>
                                    <includedLicense>BSD-3-Clause</includedLicense>
                                    <includedLicense>EDL-1.0 (BSD-3-Clause)</includedLicense>
                                    <includedLicense>EPL-1.0</includedLicense>
                                    <includedLicense>EPL-2.0</includedLicense>
                                    <includedLicense>GPL-2.0-only WITH Classpath-exception-2.0</includedLicense>
                                    <includedLicense>CDDL-1.1 OR GPL-2.0-only WITH Classpath-exception-2.0</includedLicense>
                                    <includedLicense>LGPL-2.1-or-later</includedLicense>
                                    <includedLicense>MPL-2.0</includedLicense>
                                    <includedLicense>CC0-1.0</includedLicense>
                                    <includedLicense>Bouncy Castle Licence (MIT)</includedLicense>
                                </includedLicenses>
                                <failOnBlacklist>true</failOnBlacklist>
                                <failOnMissing>true</failOnMissing>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
