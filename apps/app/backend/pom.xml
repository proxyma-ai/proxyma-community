         Community one: everything Desktop and the Home Server are built from. -->

    <properties>
        <java.version>21</java.version>
        <!-- Where THIRD-PARTY-NOTICES' templates live (license-maven-plugin below). Right for a module
             in this directory; ee/backend/proxyma-server overrides it. -->
        <proxyma.third-party.dir>${project.basedir}/../../third-party</proxyma.third-party.dir>
        <!-- Patch floor above what the Spring Boot 3.5.16 BOM manages (Netty 4.1.135, Tomcat
             10.1.55, Jackson 2.21.4), each of which still had published advisories. Drop an
             override once a Boot release manages that version or newer. -->
        <netty.version>4.1.139.Final</netty.version>
        <tomcat.version>10.1.61</tomcat.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <proxyma-shared-contracts.version>1.3.0</proxyma-shared-contracts.version>
