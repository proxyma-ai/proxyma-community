            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
            <!-- HTML->Markdown for WebFetchTool: jsoup-based, preserves headings/lists/GFM
                 tables/links/images/code. Replaces the hand-rolled DOM-walk converter. -->
            <dependency>
                <groupId>com.vladsch.flexmark</groupId>
                <artifactId>flexmark-html2md-converter</artifactId>
                <version>${flexmark.version}</version>
            </dependency>
            <!-- Mozilla Readability (Firefox Reader View) JVM port, jsoup-based: real
                 text/link-density main-content extraction for WebFetchTool. -->
            <dependency>
                <groupId>net.dankito.readability4j</groupId>
                <artifactId>readability4j</artifactId>
                <version>${readability4j.version}</version>
            </dependency>
            <!-- Pure-Java headless browser: JS-rendering fallback for WebFetchTool on
                 SPA/JS-heavy pages. No external browser binary (works behind the
                 registry-blocking corporate proxy, keeps the desktop bundle shippable). -->
            <dependency>
                <groupId>org.htmlunit</groupId>
                <artifactId>htmlunit</artifactId>
                <version>${htmlunit.version}</version>
            </dependency>
            <!-- Real headless-Chromium renderer: optional, server-only high-fidelity JS-rendering
                 engine for WebFetchTool (handles hash routing + iframe content HtmlUnit can't).
                 Requires a downloaded browser binary, so it is opt-in via proxyma.web-fetch.js-engine
                 and degrades to HtmlUnit/static when the browser isn't installed (e.g. the desktop
                 bundle / a registry-blocked proxied host). The jar ships everywhere; only the browser
                 binary (installed at image build for the server deploy) is heavy. -->
            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>${playwright.version}</version>
            </dependency>

            <!-- SMB2/3 from the JVM, for the network-share connector. A LIBRARY rather than a CIFS
                 mount, and that is the whole design: the server runs in a container with no mount,
                 and a mount would authenticate as one identity for every user, while this
                 connector's entire point is reading a share as the SOURCE OWNER'S OWN domain
                 account so the share's ACLs decide what is indexed. See docs/architecture.html#spec-05.

                 IT COSTS ~9.2 MB IN EVERY JAR, and 8.5 MB of that is BouncyCastle (bcprov-jdk18on),
                 which nothing else here shipped before: smbj needs it for NTLM and SMB3 crypto and
                 it is not optional. Measured 2026-09-21 - smbj 608 KB, asn-one 67 KB, bcprov
                 8.5 MB. On a ~342 MB desktop jar that is under 3%, which is why it was accepted
                 rather than shelled out to a sidecar. -->
            <dependency>
                <groupId>com.hierynomus</groupId>
                <artifactId>smbj</artifactId>
                <version>${smbj.version}</version>
            </dependency>
        </dependencies>
