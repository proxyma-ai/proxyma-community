# Proxyma Home Server configuration. Copy to .env and edit. NEVER commit .env.
#
#   cp .env.example .env
#
# This is the SINGLE-USER edition, packaged to run on a machine with no screen. It is the same
# application as the Windows installer and the Linux .deb - the same one user, the same
# absence of accounts - and the only thing this package adds is the ability to reach it from
# another machine. If Proxyma is only ever used ON this machine, install the desktop edition
# instead; it needs none of the decisions below.
#
# Multi-user Proxyma - accounts, roles, single sign-on - is the server edition, and a different
# package. See https://proxyma.ai/docs/manual/#install-enterprise.

# =============================================================================
# 1. Who can reach it - READ THIS ONE
# =============================================================================
# THERE ARE NO ACCOUNTS, AND ONE ACCESS CODE. A browser asks for the code once per session; an AI
# client sends the instance's token (Settings > AI Assistants). Whoever has the code has everything:
# every document you index, every conversation, and your AI provider spend. The container prints the
# code in its log at every start:
#
#   docker compose logs proxyma | grep -A1 "access code"
#
# Leave PROXYMA_ACCESS_CODE empty to keep the generated one (stored in
# ./data/.local/share/proxyma/access-code), or set your own - at least 16 characters. A code is not
# an account system: on anything reachable from the internet, put a proxy with its own login in
# front as well.
PROXYMA_ACCESS_CODE=

#
# The host names and addresses you will type in a browser, comma-separated. localhost and
# 127.0.0.1 always work and never need listing.
#
#   PROXYMA_ALLOWED_HOSTS=                       loopback only - same as the desktop edition
#   PROXYMA_ALLOWED_HOSTS=homeserver.lan         one name on your LAN
#   PROXYMA_ALLOWED_HOSTS=homeserver.lan,192.168.1.50
#   PROXYMA_ALLOWED_HOSTS=*                      any name, including from the internet
#
# `*` is supported because some people genuinely want it behind their own tunnel or proxy. It is
# not a shortcut for "I don't know my hostname" - it switches off the check that stops a hostile
# web page in your browser from talking to this instance (DNS rebinding).
PROXYMA_ALLOWED_HOSTS=

# Which interface to publish on. 127.0.0.1 (the default) keeps it on this machine - for a tunnel,
# your own reverse proxy, or `ssh -L`. 0.0.0.0 is what makes the port reachable from your LAN at
# all; set it together with PROXYMA_ALLOWED_HOSTS above.
BIND_ADDR=127.0.0.1
HTTP_PORT=4246

# =============================================================================
# 2. The two capabilities that are NOT exposed by default
# =============================================================================
# Both are available with no restriction when PROXYMA_ALLOWED_HOSTS is empty, because loopback
# means the person at the keyboard. Once the instance is reachable from elsewhere, they are more
# than "read my documents" and they stay off unless you say otherwise.
#
# The local file API browses and registers ANY directory this container can read. On a machine
# with no screen its folder picker cannot open a dialog anyway, so there is little reason to
# turn it on - mount what you want indexed under ./data instead.
PROXYMA_EXPOSE_LOCAL_FILE_API=false

# The MCP endpoint gives an AI client the agent's tools, including the ones that WRITE to Jira,
# Confluence and Bitbucket using the credentials you stored here. A client needs the instance's
# token (Settings > AI Assistants), and anyone holding it acts as you. Turn it on only on a network
# where you would hand out those credentials directly.
PROXYMA_EXPOSE_MCP=false

# =============================================================================
# 3. Container identity and data
# =============================================================================
# The uid/gid that owns ./data. install.sh writes the invoking user's.
HOST_UID=1000
HOST_GID=1000

# Which image to run. Leave it unset to track the latest release; set it to pin a version.
# PROXYMA_IMAGE=ghcr.io/proxyma-ai/proxyma-homeserver:0.2.4

# =============================================================================
# 4. Outbound connections
# =============================================================================
# It can be switched off by setting it EMPTY, and it carries neither your documents nor your
# credentials. The telemetry URL carries conversation content in two cases only: feedback somebody
# submits with the conversation attached, and an answer rating, which sends the rated answer and
# its question anonymously when "Send diagnostics to Proxyma" is on in Settings -> About ->
# Diagnostics.
# It is not what talks to your AI provider, which you configure in the app itself.
# PROXYMA_TELEMETRY_SERVER_URL=https://telemetry.proxyma.ai

# =============================================================================
# Office Files - letting the assistant create and edit Word, Excel and PowerPoint files
# =============================================================================
# The `office` compose profile runs a sandbox container for the Python the assistant writes to do
# that. It has no network access and never sees your data directory. Its image is BUILT on this
# host at install time with pip, so an install with no internet access should drop `office` from
# COMPOSE_PROFILES - the assistant then says it cannot edit files, and everything else works.
#
# The key the two containers share. Leave empty: install.sh generates it.
PROXYMA_SANDBOX_TOKEN=

COMPOSE_PROFILES=office
